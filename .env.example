# ==============================================================================
# Hotel Mitraya Restaurant POS, Ordering & Billing System
# Environment Configuration Template
# ==============================================================================

# Application Security Key
SECRET_KEY=hotel-mitraya-production-secret-key-change-in-prod-2026

# Server Host and Port
HOST=0.0.0.0
PORT=5055

# Database Configuration (Defaults to SQLite in local restaurant, or PostgreSQL in cloud)
# Example SQLite: sqlite:///d:/mitrayabill/mitraya_pos.db
# Example PostgreSQL: postgresql://username:password@localhost:5432/mitraya_db
DATABASE_URL=

# Default Role PINs (Can be modified by Admin in Portal)
ADMIN_PIN=2005
CASHIER_PIN=1234
WAITER_PIN=5678

# Thermal Printer Hardware Settings (58mm or 80mm)
# PRINTER_CONNECTION_TYPE options: WINDOWS_DRIVER | NETWORK_RAW | ESC_POS_RAW | BROWSER_PRINT
PRINTER_CONNECTION_TYPE=WINDOWS_DRIVER
DEFAULT_PRINTER_NAME=
DEFAULT_PRINTER_WIDTH=80
PRINTER_NETWORK_IP=
PRINTER_NETWORK_PORT=9100
