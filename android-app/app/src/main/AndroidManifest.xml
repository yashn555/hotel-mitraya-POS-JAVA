<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Hardware Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Bluetooth Thermal Printing Permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <application
        android:name=".HotelMitrayaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HotelMitraya"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Entry Point: Login Activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Role Router Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Waiter Activities -->
        <activity
            android:name=".ui.waiter.WaiterTablesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.waiter.WaiterOrderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Cashier / POS Activity -->
        <activity
            android:name=".ui.pos.PosCounterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Kitchen Display (KDS) Activity -->
        <activity
            android:name=".ui.kitchen.KitchenDisplayActivity"
            android:exported="false" />

        <!-- Admin Dashboard Activity -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <!-- Settings Activities -->
        <activity
            android:name=".ui.settings.ServerSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.PrinterSettingsActivity"
            android:exported="false" />

    </application>

</manifest>
