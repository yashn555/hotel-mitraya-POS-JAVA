<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Table Name & Elapsed Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTicketTable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Table 1"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTicketElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 5m ago"
                android:textColor="@color/brand_gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTicketOrderNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Order #ORD-20260906-001"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/card_border" />

        <!-- Dishes List Container -->
        <LinearLayout
            android:id="@+id/layoutTicketDishes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Cooking Notes -->
        <TextView
            android:id="@+id/tvTicketNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:padding="8dp"
            android:textColor="@color/brand_crimson"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <!-- Status Button (Mark Ready) -->
        <Button
            android:id="@+id/btnMarkReady"
            style="@style/Widget.HotelMitraya.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/mark_ready"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
