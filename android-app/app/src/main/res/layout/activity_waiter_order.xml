<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header with Back Button and Table Name -->
        <LinearLayout
            android:id="@+id/layoutOrderHeader"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/bg_surface"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackToTables"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/brand_navy" />

            <TextView
                android:id="@+id/tvOrderTableTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Order for Table 1"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvExistingOrderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_occupied"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="EDITING ACTIVE"
                android:textColor="@color/brand_crimson"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Search Dish Bar -->
        <EditText
            android:id="@+id/etSearchDish"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/text_muted"
            android:hint="@string/search_dish_hint"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/layoutOrderHeader" />

        <!-- Horizontal Categories RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/etSearchDish" />

        <!-- Dishes List RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMenuItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingVertical="6dp"
            android:paddingBottom="130dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvCategoryTabs" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Cart Drawer Summary Bar -->
    <LinearLayout
        android:id="@+id/bottomCartDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_surface"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cart Items Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCartCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cart: 0 items"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCartSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="₹0.00"
                android:textColor="@color/brand_navy"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Cooking Notes Input -->
        <EditText
            android:id="@+id/etCookingNotes"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/cooking_notes_hint"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <!-- Send KOT / Place Order Button -->
        <Button
            android:id="@+id/btnSubmitOrder"
            style="@style/Widget.HotelMitraya.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/send_kot"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
